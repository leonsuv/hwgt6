@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- hwgt6: die Opel-Variante holt die Fahrzeugdaten lokal von der Opel-Bridge-App,
+     bevorzugt ueber deren ContentProvider (startet die App bei Bedarf selbst),
+     sonst ueber http://127.0.0.1:8787 - dafuer der Netzwerkzugriff. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+    <uses-permission android:name="android.permission.INTERNET" />
+    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
+    <queries>
+        <provider android:authorities="de.saigak.opelbridge.watch" />
+    </queries>
+</manifest>
