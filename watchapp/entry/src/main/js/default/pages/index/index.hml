<stack class="page">

  <!-- Karten: 1 Uebersicht  2 Laden  3 Fahrzeug  4 Menue -->
  <swiper class="swiper" index="{{page}}" loop="false" onchange="onSwipe">

    <!-- ============================ Karte 1: Uebersicht ================= -->
    <stack class="card">
      <progress class="ring-inner" type="arc" percent="100"></progress>
      <progress class="ring" type="arc" percent="{{ringNow}}"
                style="color: {{view.accent}};"></progress>

      <div class="center">
        <text class="age" style="color: {{ageColor}};">{{ageLine}}</text>
        <div class="level-row">
          <text class="level-num1" style="color: {{view.accent}};" if="{{levelD1}}">{{levelNow}}</text>
          <text class="level-num2" style="color: {{view.accent}};" if="{{levelD2}}">{{levelNow}}</text>
          <text class="level-num3" style="color: {{view.accent}};" if="{{levelD3}}">{{levelNow}}</text>
          <text class="level-unit" style="color: {{view.accent}};" if="{{hasLevel}}">%</text>
        </div>
        <div class="range-row">
          <text class="range-num1" if="{{rangeD1}}">{{rangeNum}}</text>
          <text class="range-num2" if="{{rangeD2}}">{{rangeNum}}</text>
          <text class="range-num3" if="{{rangeD3}}">{{rangeNum}}</text>
          <text class="range-unit" if="{{hasRange}}">{{rangeUnit}}</text>
        </div>
        <image class="plug-icon-pulse" src="{{plugIconS}}" if="{{isCharging}}"></image>
        <image class="plug-icon" src="{{plugIconS}}" if="{{notCharging}}"></image>
        <text class="odo">{{odoLine}}</text>
      </div>
    </stack>

    <!-- ============================ Karte 2: Laden ====================== -->
    <div class="card-col">
      <text class="eyebrow">{{L.charge}}</text>
      <image class="hero-icon-pulse" src="{{plugIconL}}" if="{{isCharging}}"></image>
      <image class="hero-icon" src="{{plugIconL}}" if="{{notCharging}}"></image>
      <text class="hero-text" style="color: {{plugColor}};">{{chargeHero}}</text>
      <div class="stats">
        <div class="stat">
          <text class="stat-value">{{statA}}</text>
          <text class="stat-label">{{statALabel}}</text>
        </div>
        <div class="stat-sep"></div>
        <div class="stat">
          <text class="stat-value">{{statB}}</text>
          <text class="stat-label">{{statBLabel}}</text>
        </div>
      </div>
    </div>

    <!-- ============================ Karte 3: Fahrzeug =================== -->
    <div class="card-col" onclick="goDetail">
      <text class="eyebrow">{{nameUpper}}</text>
      <image class="hero-icon" src="{{lockIcon}}"></image>
      <text class="hero-text" style="color: {{lockColor}};">{{lockText}}</text>
      <div class="stats">
        <div class="stat3">
          <text class="stat3-value">{{outsideShort}}</text>
          <text class="stat3-label">{{L.outside}}</text>
        </div>
        <div class="stat-sep"></div>
        <div class="stat3">
          <text class="stat3-value" style="color: {{doorColor}};">{{doorsShort}}</text>
          <text class="stat3-label">{{L.doors}}</text>
        </div>
        <div class="stat-sep"></div>
        <div class="stat3">
          <text class="stat3-value">{{climateRow}}</text>
          <text class="stat3-label">{{L.climate}}</text>
        </div>
      </div>
      <text class="alert" if="{{view.hasAlerts}}">{{alertText}}</text>
    </div>

    <!-- ============================ Karte 4: Menue ====================== -->
    <div class="card-col">
      <div class="big-btn" onclick="forceRefresh">
        <image class="big-btn-icon-spin" src="/common/images/refresh.png" if="{{busy}}"></image>
        <image class="big-btn-icon" src="/common/images/refresh.png" if="{{notBusy}}"></image>
      </div>
      <text class="big-btn-label">{{L.refresh}}</text>
      <div class="small-btns">
        <div class="small-btn" onclick="goDetail">
          <image class="small-btn-icon" src="/common/images/info.png"></image>
        </div>
        <div class="small-btn" onclick="goSettings">
          <image class="small-btn-icon" src="/common/images/gear.png"></image>
        </div>
      </div>
      <text class="foot" style="color: {{ageColor}};">{{ageFoot}}</text>
    </div>

  </swiper>

  <!-- Seitenpunkte: im Spalt unten zwischen den Ringenden -->
  <div class="dots">
    <div class="dot" style="background-color: {{dot0}};"></div>
    <div class="dot" style="background-color: {{dot1}};"></div>
    <div class="dot" style="background-color: {{dot2}};"></div>
    <div class="dot" style="background-color: {{dot3}};"></div>
  </div>

  <!-- Kurzmeldung nach Aktionen -->
  <div class="toast" if="{{toastText}}">
    <text class="toast-text">{{toastText}}</text>
  </div>

</stack>
