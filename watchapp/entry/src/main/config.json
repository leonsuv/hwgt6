{
  "app": {
    "bundleName": "de.saigak.opelwatch",
    "vendor": "saigak",
    "version": {
      "code": 1000000,
      "name": "1.0.0"
    },
    "apiVersion": {
      "compatible": 6,
      "target": 6,
      "releaseType": "Release"
    }
  },
  "deviceConfig": {
    "default": {
      "network": {
        "cleartextTraffic": true
      }
    }
  },
  "module": {
    "package": "de.saigak.opelwatch",
    "name": ".MyApplication",
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "reqPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "Fahrzeugdaten von der Opel-Bridge laden"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "Rueckmeldung bei Aktionen"
      }
    ],
    "abilities": [
      {
        "name": ".MainAbility",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "description": "$string:app_desc",
        "launchType": "standard",
        "type": "page",
        "visible": true,
        "skills": [
          {
            "actions": [
              "action.system.home"
            ],
            "entities": [
              "entity.system.home"
            ]
          }
        ]
      }
    ],
    "js": [
      {
        "pages": [
          "pages/index/index",
          "pages/detail/detail",
          "pages/settings/settings"
        ],
        "name": "default",
        "window": {
          "designWidth": 466,
          "autoDesignWidth": false
        }
      }
    ]
  }
}
