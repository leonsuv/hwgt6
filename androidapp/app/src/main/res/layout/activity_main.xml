<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111318"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#F5A623"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"
            android:textColor="#8C93A0"
            android:textSize="13sp" />

        <!-- Zustand des Dienstes -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1B1E25"
            android:padding="14dp"
            android:text="@string/status_stopped"
            android:textColor="#E9EAEE"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#2A1414"
            android:padding="12dp"
            android:textColor="#FF7A7A"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Konto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_account"
            android:textColor="#8C93A0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/accountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/not_logged_in"
            android:textColor="#E9EAEE"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/countryInput"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:autofillHints="countryCode"
                android:hint="@string/country"
                android:inputType="textCapCharacters"
                android:maxLength="2"
                android:textColor="#E9EAEE"
                android:textColorHint="#5A6070" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/login" />
        </LinearLayout>

        <!-- Dienst -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_service"
            android:textColor="#8C93A0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/start_bridge" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh_now" />

        <!-- Uhr (Wear Engine) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_wear"
            android:textColor="#8C93A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/wear_hint"
            android:textColor="#8C93A0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/watchText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1B1E25"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/pairWatchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_watch" />

        <Button
            android:id="@+id/reconnectWatchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reconnect_watch" />

        <!-- HTTP-Schnittstelle (Browser-Test, PC-Vorschau) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_watch"
            android:textColor="#8C93A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/watch_hint"
            android:textColor="#8C93A0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/urlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1B1E25"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#3DDC84"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tokenText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1B1E25"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#F5A623"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/copyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_config" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/logout" />

    </LinearLayout>
</ScrollView>
